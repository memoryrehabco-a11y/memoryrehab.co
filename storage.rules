rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'memoryrehab.co@gmail.com';
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
